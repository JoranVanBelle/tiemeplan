<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.joranvanbelle.tiemeplan</groupId>
  <artifactId>tiemeplan</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <name>tiemeplan</name>
  <url>https://github.com/JoranVanBelle/tiemeplan</url>

  <description>Create time plans for schools using constraints</description>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Joran Van Belle</name>
      <email>joran.vanbelle@live.be</email>
      <roles>
        <role>author</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>26</java.version>
    <junit-jupiter.version>6.1.3</junit-jupiter.version>
    <assertj.version>3.27.7</assertj.version>
    <javafx.version>27</javafx.version>
    <jackson.version>3.0.0</jackson.version>
    <openpdf.version>1.3.39</openpdf.version>
    <opencsv.version>5.9</opencsv.version>

    <!-- Plugins -->
    <spotless.version>3.10.4</spotless.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
    <jpackage.maven.plugin.version>1.8.0</jpackage.maven.plugin.version>
    <jreleaser.maven.plugin.version>1.27.0</jreleaser.maven.plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
    <versions-maven-plugin.version>2.25.2</versions-maven-plugin.version>

    <!-- Packaging -->
    <app.main.module>io.joranvanbelle.tiemeplan</app.main.module>
    <app.main.class>io.joranvanbelle.tiemeplan.Tiemeplan</app.main.class>
    <app.image.directory>${project.build.directory}/app-image</app.image.directory>
    <!-- An application image is a self-contained directory with a launcher and a Java runtime.
         It can only be built for the operating system the build runs on. -->
    <jpackage.type>APP_IMAGE</jpackage.type>
    <!-- Placeholder icons: replace the files in src/main/packaging with the real artwork. -->
    <jpackage.icon>${project.basedir}/src/main/packaging/icon.png</jpackage.icon>
    <jpackage.app.version>${project.version}</jpackage.app.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Jackson 3 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Export -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.opencsv</groupId>
      <artifactId>opencsv</artifactId>
      <version>${opencsv.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <nonFilteredFileExtensions>
            <nonFilteredFileExtension>ttf</nonFilteredFileExtension>
          </nonFilteredFileExtensions>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>${javafx.maven.plugin.version}</version>
        <configuration>
          <mainClass>io.joranvanbelle.tiemeplan.Tiemeplan</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>${versions-maven-plugin.version}</version>
        <configuration>
          <generateBackupPoms>false</generateBackupPoms>
        </configuration>
      </plugin>

      <!-- Formatter -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>apply</goal>
            </goals>
            <phase>test</phase>
          </execution>
        </executions>
        <configuration>
          <formats>
            <format>
              <includes>
                <include>.gitattributes</include>
                <include>.gitignore</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
          <java>
            <forbidWildcardImports/>
            <toggleOffOn/>
            <eclipse>
              <version>4.26</version>
              <file>formatter.xml</file>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <file>import-order.txt</file>
            </importOrder>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Builds a self-contained application for the current operating system:

        mvn clean package -Papp-image

      1. The JavaFX jars and the remaining runtime dependencies are copied to separate directories.
      2. jlink creates a runtime image containing the JDK modules and JavaFX.
      3. jpackage bundles that runtime with the application and its dependencies.

      Most third-party dependencies are automatic modules, which jlink cannot link.
      They are therefore placed on the module path of the packaged application instead.
    -->
    <profile>
      <id>app-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>copy-javafx</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <includeGroupIds>org.openjfx</includeGroupIds>
                  <outputDirectory>${app.image.directory}/javafx</outputDirectory>
                </configuration>
              </execution>
              <execution>
                <id>copy-libraries</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <excludeGroupIds>org.openjfx</excludeGroupIds>
                  <outputDirectory>${app.image.directory}/mods</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>jlink-runtime</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--module-path</argument>
                    <argument>${app.image.directory}/javafx</argument>
                    <argument>--add-modules</argument>
                    <!-- JavaFX modules pull in the JDK modules they need. The others are
                         required by the application or by its automatic-module dependencies. -->
                    <argument>javafx.controls,javafx.fxml,javafx.swing,java.desktop,java.prefs,java.sql,java.xml,java.logging,java.naming,jdk.charsets</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--output</argument>
                    <argument>${app.image.directory}/runtime</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-application-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${app.image.directory}/mods</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${project.build.finalName}.jar</include>
                      </includes>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>${jpackage.maven.plugin.version}</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <type>${jpackage.type}</type>
              <icon>${jpackage.icon}</icon>
              <name>Tiemeplan</name>
              <appVersion>${jpackage.app.version}</appVersion>
              <vendor>Joran Van Belle</vendor>
              <description>${project.description}</description>
              <destination>${app.image.directory}/dist</destination>
              <runtimeImage>${app.image.directory}/runtime</runtimeImage>
              <modulePaths>
                <modulePath>${app.image.directory}/mods</modulePath>
              </modulePaths>
              <module>${app.main.module}/${app.main.class}</module>
              <javaOptions>
                <javaOption>--enable-native-access=javafx.graphics</javaOption>
              </javaOptions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Every platform is distributed as a plain application image, archived by the release workflow.
         Linux uses the default icon.png. -->
    <profile>
      <id>app-image-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/packaging/icon.ico</jpackage.icon>
      </properties>
    </profile>

    <profile>
      <id>app-image-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/packaging/icon.icns</jpackage.icon>
      </properties>
    </profile>

    <!--
      Publishes a GitHub release containing the archives found in target/app-image/dist:

        mvn -Prelease jreleaser:full-release

      Requires the JRELEASER_GITHUB_TOKEN environment variable.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jreleaser</groupId>
            <artifactId>jreleaser-maven-plugin</artifactId>
            <version>${jreleaser.maven.plugin.version}</version>
            <configuration>
              <jreleaser>
                <project>
                  <name>tiemeplan</name>
                  <license>Apache-2.0</license>
                  <inceptionYear>2026</inceptionYear>
                </project>
                <release>
                  <github>
                    <owner>JoranVanBelle</owner>
                    <name>tiemeplan</name>
                    <tagName>v{{projectVersion}}</tagName>
                    <releaseName>Tiemeplan {{projectVersion}}</releaseName>
                    <!-- Closing milestones needs the issues permission, which the workflow token lacks. -->
                    <milestone>
                      <close>false</close>
                    </milestone>
                    <changelog>
                      <formatted>ALWAYS</formatted>
                      <preset>conventional-commits</preset>
                    </changelog>
                  </github>
                </release>
                <checksum>
                  <individual>true</individual>
                </checksum>
                <files>
                  <globs>
                    <glob>
                      <pattern>${app.image.directory}/dist/*.tar.gz</pattern>
                    </glob>
                    <glob>
                      <pattern>${app.image.directory}/dist/*.zip</pattern>
                    </glob>
                  </globs>
                </files>
              </jreleaser>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
